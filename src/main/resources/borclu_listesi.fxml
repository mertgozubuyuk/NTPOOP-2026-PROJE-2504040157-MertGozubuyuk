<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.proje.controller.BorcluListesiController">
    <children>
        <TableView fx:id="borcluTablosu" layoutX="76.0" layoutY="71.0" prefHeight="450.0" prefWidth="650.0">
            <columns>
                <TableColumn fx:id="colAdSoyad" prefWidth="250.0" text="Sakin" />
                <TableColumn fx:id="colMiktar" prefWidth="200.0" text="Borç Miktarı" />
                <TableColumn fx:id="colAy" prefWidth="200.0" text="Dönem(Ay)" />
            </columns>
        </TableView>
        <Button fx:id="odemeYapButonu" layoutX="76.0" layoutY="540.0"
                prefWidth="200.0" prefHeight="35.0"
                text="Ödeme Yap"
                onAction="#handleOdemeYap"/>
    </children>
</AnchorPane>
